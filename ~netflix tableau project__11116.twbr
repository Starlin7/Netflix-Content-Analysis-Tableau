      <column caption='Total Movies' datatype='integer' name='[Calculation_0763954075045889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [type] = &quot;Movie&quot;&#13;&#10;    THEN [show_id]&#13;&#10;    END&#13;&#10;)' />
